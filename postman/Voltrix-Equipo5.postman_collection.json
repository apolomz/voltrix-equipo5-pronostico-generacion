              "host": ["{{base_url}}"],
              "path": ["pronosticos", "{{planta_id}}"]
            }
          }
        },
        {
          "name": "Generar lote de 80 plantas (opcional)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = Array.from({ length: 80 }, (_, i) => \"PL-\" + String(i + 1).padStart(3, \"0\"));",
                  "pm.variables.set(\"plantas_80\", JSON.stringify(ids));",
                  "console.log(\"plantas:\", ids.length);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "pm.test(\"80 plantas\", () => pm.expect(data.cantidad_plantas).to.eql(80));",
                  "pm.test(\"Origen demo\", () => pm.expect(data.origen_datos).to.eql(\"demo\"));",
                  "console.log(\"lote 80:\", JSON.stringify(data.metricas));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
