        {
          "name": "Consultar último pronóstico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "pm.test(\"Planta PL-001\", () => pm.expect(data.planta_id).to.eql(\"PL-001\"));",
                  "pm.test(\"Tiene valores\", () => pm.expect(data.valores.length).to.be.greaterThan(0));",
                  "console.log(\"pronóstico:\", data.planta_id, data.valores.length, \"puntos\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
