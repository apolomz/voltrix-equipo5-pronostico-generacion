{
  "openapi": "3.1.0",
  "info": {
    "title": "Voltrix Energy - Pronóstico de Generación",
    "description": "API del Equipo 5 para estimar la generación futura por planta. Incluye descomposición de datos por planta, ejecución secuencial, por hilos o por procesos, y una capa de entrada de datos con modo demo y clientes para Inventario, Telemetría y Reportes.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operación"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaSalud"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaSalud"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.yaml": {
      "get": {
        "tags": [
          "Operación"
        ],
        "summary": "Descargar contrato OpenAPI en YAML",
        "operationId": "obtener_contrato_yaml_openapi_yaml_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/dependencias/estado": {
      "get": {
        "tags": [
          "Operación"
        ],
        "summary": "Comprobar la conectividad con Inventario, Telemetría y Reportes",
        "operationId": "estado_dependencias_dependencias_estado_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaDependencias"
                }
              }
            }
          }
        }
      }
    },
    "/pronosticos/generar": {
      "post": {
        "tags": [
          "Pronósticos"
        ],
        "summary": "Generar pronósticos para varias plantas",
        "operationId": "generar_pronosticos_endpoint_pronosticos_generar_post",
        "parameters": [
          {
            "name": "modo",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ModoEjecucion",
              "description": "Modo de ejecución: secuencial (línea base) o paralelo.",
              "default": "paralelo"
            },
            "description": "Modo de ejecución: secuencial (línea base) o paralelo."
          },
          {
            "name": "workers",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 64,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cantidad de workers a emplear en modo paralelo.",
              "title": "Workers"
            },
            "description": "Cantidad de workers a emplear en modo paralelo."
          },
          {
            "name": "backend",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/BackendEjecucion"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Backend paralelo: auto, thread o process. Si se omite, usa PARALLEL_BACKEND.",
              "title": "Backend"
            },
            "description": "Backend paralelo: auto, thread o process. Si se omite, usa PARALLEL_BACKEND."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudGeneracion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaGeneracion"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud o rango inválido."
          },
          "404": {
            "description": "Alguna planta no existe en Inventario."
          },
          "429": {
            "description": "Sobrecarga; reintentar con Retry-After."
          },
          "502": {
            "description": "Una dependencia falló o no hay datos disponibles."
          },
          "503": {
            "description": "Base de datos o configuración no disponible."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pronosticos/{plantaId}": {
      "get": {
        "tags": [
          "Pronósticos"
        ],
        "summary": "Consultar el último pronóstico de una planta",
        "operationId": "consultar_pronostico_pronosticos__plantaId__get",
        "parameters": [
          {
            "name": "plantaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plantaid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PronosticoPlanta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BackendEjecucion": {
        "type": "string",
        "enum": [
          "auto",
          "thread",
          "process"
        ],
        "title": "BackendEjecucion"
      },
      "EstadoFuente": {
        "properties": {
          "equipo": {
            "type": "string",
            "title": "Equipo"
          },
          "servicio": {
            "type": "string",
            "title": "Servicio"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "no_aplica",
              "no_configurado"
            ],
            "title": "Estado"
          },
          "latenciaMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latenciams"
          },
          "detalle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detalle"
          }
        },
        "type": "object",
        "required": [
          "equipo",
          "servicio",
          "estado"
        ],
        "title": "EstadoFuente"
      },
      "Frecuencia": {
        "type": "string",
        "enum": [
          "hora",
          "dia"
        ],
        "title": "Frecuencia"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricasProcesamiento": {
        "properties": {
          "modo": {
            "$ref": "#/components/schemas/ModoEjecucion"
          },
          "workers": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Workers"
          },
          "elementos": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elementos"
          },
          "duracionMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duracionms"
          }
        },
        "type": "object",
        "required": [
          "modo",
          "workers",
          "elementos",
          "duracionMs"
        ],
        "title": "MetricasProcesamiento"
      },
      "ModoEjecucion": {
        "type": "string",
        "enum": [
          "secuencial",
          "paralelo"
        ],
        "title": "ModoEjecucion"
      },
      "OrigenDatos": {
        "type": "string",
        "enum": [
          "demo",
          "dependencias",
          "mixto"
        ],
        "title": "OrigenDatos"
      },
      "PronosticoPlanta": {
        "properties": {
          "planta_id": {
            "type": "string",
            "title": "Planta Id"
          },
          "metodo": {
            "type": "string",
            "const": "regresion_lineal",
            "title": "Metodo",
            "default": "regresion_lineal"
          },
          "frecuencia": {
            "$ref": "#/components/schemas/Frecuencia"
          },
          "generado_en": {
            "type": "string",
            "format": "date-time",
            "title": "Generado En"
          },
          "valores": {
            "items": {
              "$ref": "#/components/schemas/PuntoPronostico"
            },
            "type": "array",
            "title": "Valores"
          }
        },
        "type": "object",
        "required": [
          "planta_id",
          "frecuencia",
          "generado_en",
          "valores"
        ],
        "title": "PronosticoPlanta"
      },
      "PuntoPronostico": {
        "properties": {
          "periodo": {
            "type": "string",
            "format": "date-time",
            "title": "Periodo"
          },
          "generacion_kwh": {
            "type": "number",
            "minimum": 0.0,
            "title": "Generacion Kwh"
          }
        },
        "type": "object",
        "required": [
          "periodo",
          "generacion_kwh"
        ],
        "title": "PuntoPronostico"
      },
      "RespuestaDependencias": {
        "properties": {
          "modoDatos": {
            "type": "string",
            "enum": [
              "demo",
              "real"
            ],
            "title": "Mododatos"
          },
          "fuentes": {
            "items": {
              "$ref": "#/components/schemas/EstadoFuente"
            },
            "type": "array",
            "title": "Fuentes"
          }
        },
        "type": "object",
        "required": [
          "modoDatos",
          "fuentes"
        ],
        "title": "RespuestaDependencias"
      },
      "RespuestaGeneracion": {
        "properties": {
          "modo_ejecucion": {
            "$ref": "#/components/schemas/ModoEjecucion"
          },
          "backend_paralelismo": {
            "type": "string",
            "enum": [
              "secuencial",
              "thread",
              "process"
            ],
            "title": "Backend Paralelismo"
          },
          "origen_datos": {
            "$ref": "#/components/schemas/OrigenDatos",
            "default": "demo"
          },
          "cantidad_plantas": {
            "type": "integer",
            "title": "Cantidad Plantas"
          },
          "pronosticos": {
            "items": {
              "$ref": "#/components/schemas/PronosticoPlanta"
            },
            "type": "array",
            "title": "Pronosticos"
          },
          "metricas": {
            "$ref": "#/components/schemas/MetricasProcesamiento"
          },
          "advertencia": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advertencia"
          }
        },
        "type": "object",
        "required": [
          "modo_ejecucion",
          "backend_paralelismo",
          "cantidad_plantas",
          "pronosticos",
          "metricas"
        ],
        "title": "RespuestaGeneracion"
      },
      "RespuestaSalud": {
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "no_disponible"
            ],
            "title": "Estado",
            "default": "disponible"
          },
          "baseDatos": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Basedatos",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          },
          "tiempoActivoSeg": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tiempoactivoseg"
          }
        },
        "type": "object",
        "required": [
          "tiempoActivoSeg"
        ],
        "title": "RespuestaSalud"
      },
      "SolicitudGeneracion": {
        "properties": {
          "planta_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Planta Ids",
            "description": "Identificadores de las plantas que se desean pronosticar.",
            "examples": [
              [
                "PL-001",
                "PL-002"
              ]
            ]
          },
          "horizonte_periodos": {
            "type": "integer",
            "maximum": 168.0,
            "minimum": 1.0,
            "title": "Horizonte Periodos",
            "description": "Cantidad de periodos futuros que se desean estimar.",
            "default": 6,
            "examples": [
              6
            ]
          },
          "frecuencia": {
            "$ref": "#/components/schemas/Frecuencia",
            "description": "Resolución temporal del pronóstico.",
            "default": "hora"
          },
          "desde": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Desde",
            "description": "Inicio opcional del rango histórico (RFC 3339 con zona horaria)."
          },
          "hasta": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hasta",
            "description": "Fin opcional del rango histórico (RFC 3339 con zona horaria)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "planta_ids"
        ],
        "title": "SolicitudGeneracion",
        "description": "Solicitud para generar pronósticos de una o varias plantas.\n\nSe aceptan tanto ``planta_ids`` (contrato actual) como ``plantaIds``\n(convención de la plantilla común) para facilitar la integración."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Operación",
      "description": "Salud del servicio, contrato y dependencias."
    },
    {
      "name": "Pronósticos",
      "description": "Generación y consulta de pronósticos."
    }
  ],
  "servers": [
    {
      "url": "http://{host}:{puerto}",
      "description": "Despliegue del Componente B (EC2) o entorno local.",
      "variables": {
        "host": {
          "default": "localhost",
          "description": "IP pública o DNS de la instancia EC2."
        },
        "puerto": {
          "default": "8000",
          "description": "Puerto de la API."
        }
      }
    }
  ]
}
