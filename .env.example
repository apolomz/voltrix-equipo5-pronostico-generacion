# =============================================================================
# Modo demo del Avance 1
# =============================================================================
DEMO_MODE=true
DEMO_PLANTAS=80
DEMO_DIAS=30
# Si una planta no tiene datos reales, completarla con el generador demo.
DEMO_FALLBACK=false

# =============================================================================
# Motor de pronóstico
# =============================================================================
MAX_WORKERS=2
PARALLEL_BACKEND=thread
MAX_CONCURRENT_REQUESTS=1

# =============================================================================
# Capa de datos / dependencias (Equipos 1, 2 y 4)
# En modo demo no se usan. Para probar contra el mock local:
#   python scripts/mock_dependencias.py
# y luego DEMO_MODE=false con las URLs de abajo.
# =============================================================================
INVENTARIO_URL=http://localhost:8001
TELEMETRIA_URL=http://localhost:8002
REPORTES_URL=http://localhost:8004
HTTP_TIMEOUT=5
HTTP_RETRIES=2
FETCH_WORKERS=8
MAX_RANGO_DIAS=31
MAX_PAGINAS=50
VALIDAR_ACTIVOS=true
REPORTES_GENERAR_SI_VACIO=false

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=voltrix
POSTGRES_USER=voltrix
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA

# =============================================================================
# Operación
# =============================================================================
API_PORT=8000
LOG_LEVEL=INFO
